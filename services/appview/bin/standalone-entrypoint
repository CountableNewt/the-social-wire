#!/bin/sh
set -eu
umask 077
case "${DATABASE_BACKEND:-sqlite}" in
  turso)
    if [ "${BACKEND_MODE:-}" != standalone ]; then
      echo 'Remote backend requires BACKEND_MODE=standalone.' >&2
      exit 1
    fi
    # Remote stores must never create or use an ephemeral local database.
    # Go validates both endpoint/token pairs and schema readiness before serving.
    if [ "$(id -u)" = 0 ]; then
      exec runuser -u appuser -- "$@"
    fi
    exec "$@"
    ;;
  sqlite) ;;
  *) echo 'DATABASE_BACKEND must be sqlite or turso.' >&2; exit 1 ;;
esac
# The standalone image has one fixed persistent mount. Do not use the ephemeral root filesystem.
if [ "${BACKEND_MODE:-}" != standalone ] || [ "${SQLITE_DB_PATH:-}" != /data/social-wire.sqlite ]; then
  echo 'Standalone backend requires BACKEND_MODE=standalone and SQLITE_DB_PATH=/data/social-wire.sqlite.' >&2
  exit 1
fi
# A writable directory on the image's root filesystem is not durable storage.
# Check before initialization or import so a missing volume cannot look healthy.
if ! mountpoint -q /data; then
  echo 'Standalone backend requires a persistent volume mounted at /data.' >&2
  exit 1
fi
if [ "$(id -u)" = 0 ]; then
  install -d -m 0700 -o appuser -g appuser /data
  databases="social-wire.sqlite scheduling.sqlite"
  for database in $databases; do
    for suffix in '' -wal -shm; do
      file="/data/${database}${suffix}"
      if [ -L "$file" ]; then echo 'Refusing a symlinked database file.' >&2; exit 1; fi
      if [ -e "$file" ]; then chown appuser:appuser "$file"; chmod 0600 "$file"; fi
    done
  done
  exec runuser -u appuser -- "$0" "$@"
fi
if [ ! -w /data ]; then echo 'Persistent /data volume must be writable.' >&2; exit 1; fi
# Each SQLite store migrates before the HTTP listener starts. No Postgres migration gate applies.
exec "$@"
