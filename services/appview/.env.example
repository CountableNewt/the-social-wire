# Standalone Go AppView. Configure real hosted values in service variables.
# APP_ENV accepts dev or prod; the hosting platform supplies PORT.
# Vercel backend project Root Directory: services/appview (Services Beta).
APP_ENV=dev
PORT=8081
BIND_HOST=::
BACKEND_MODE=standalone
# Local/Railway default. Vercel requires serverless + turso + external jobs.
RUNTIME_MODE=server
SQLITE_DB_PATH=/data/social-wire.sqlite

# Optional dotenv path; process variables take precedence.
DOTENV_PATH=.env
ATPROTO_PLC_URL=https://plc.directory

# Scheduling is always enabled. Preserve the existing encrypted-session key
# when renaming EMBEDDED_SCHEDULING_STORAGE_KEY during the Development cutover.
SCHEDULING_PUBLIC_ORIGIN=https://api.testing.thesocialwire.app
SCHEDULING_STORAGE_KEY=<base64-encoded-32-byte-key>

# OAuth attestation and private draft configuration are also required for
# hosted startup. See docs/architecture/standalone-reader.md for that contract.
PDS_ATTESTATION_RECEIPT_SECRET=<openssl-rand-hex-32>

# Preserve the existing AES storage key when moving encrypted private drafts.
# S3 remains the Railway default until ciphertext migration has been verified.
SOCIAL_DRAFT_STORAGE_BACKEND=s3
# Vercel private Blob alternative (server-only, separate store per environment):
# SOCIAL_DRAFT_STORAGE_BACKEND=vercel-blob
# BLOB_READ_WRITE_TOKEN=<private-blob-store-read-write-token>
# Migration-only alternative to a permanent destination token: supply the
# owner-only JSON file from `vercel blob signed-token` (get+put, one-hour limit).
# These credentials never configure the serving runtime; do not combine with
# BLOB_READ_WRITE_TOKEN when running draft-object-migrate.
# BLOB_MIGRATION_SIGNED_TOKEN_FILE=/absolute/private/blob-migration-auth.json
# BLOB_MIGRATION_STORE_ID=store_<development-or-production-store-id>

# Internal retains server maintenance timers; external disables all eight job
# timers and the process heartbeat. Arrange an external caller before selecting it.
JOBS_RUNNER_MODE=internal
# Optional for internal mode; required for external. Never expose to Web/iOS.
JOBS_SECRET=<unique-random-secret-at-least-32-characters>
# Serverless additionally requires a distinct Cron secret, also 32-512 characters.
# Vercel sends it as Bearer auth to GET /internal/cron/*; manual POST jobs use JOBS_SECRET.
# CRON_SECRET=<different-unique-random-secret-at-least-32-characters>

# Vercel config selects serverless/turso/external. Supply both remote stores below.
# Explicit release-only schema initialization is opt-in; Preview never initializes.
# Requires VERCEL_ENV=production and APP_ENV:VERCEL_GIT_COMMIT_REF=dev:dev or prod:main.
# DEPLOY_SCHEMA_INITIALIZATION=false

# Local SQLite remains the deployment default until remote cutover acceptance.
DATABASE_BACKEND=sqlite
# DATABASE_BACKEND=turso selects the new Turso engine via the pure-Go remote driver.
# Supply BOTH distinct database endpoints and BOTH server-only tokens; no fallback.
# TURSO_DATABASE_URL=turso://appview-organization.turso.io
# TURSO_AUTH_TOKEN=<server-only-token>
# SCHEDULING_TURSO_DATABASE_URL=turso://scheduling-organization.turso.io
# SCHEDULING_TURSO_AUTH_TOKEN=<server-only-token>
