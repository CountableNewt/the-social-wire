{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "env": {
    "RUNTIME_MODE": "serverless",
    "DATABASE_BACKEND": "turso",
    "JOBS_RUNNER_MODE": "external"
  },
  "services": {
    "appview": {
      "root": ".",
      "framework": "go",
      "entrypoint": "cmd/appview/main.go",
      "buildCommand": "bash scripts/vercel-build.sh",
      "functions": {
        "cmd/appview/main.go": {
          "maxDuration": 300,
          "regions": ["sfo1"]
        }
      }
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "appview" } }
  ],
  "crons": [
    { "path": "/internal/cron/scheduling", "schedule": "* * * * *" },
    { "path": "/internal/cron/discovery", "schedule": "* * * * *" },
    { "path": "/internal/cron/drafts-cleanup", "schedule": "*/15 * * * *" },
    { "path": "/internal/cron/ttl-cleanup", "schedule": "0 * * * *" },
    { "path": "/internal/cron/rss-poll", "schedule": "*/30 * * * *" },
    { "path": "/internal/cron/analytics-cleanup", "schedule": "0 0 * * *" },
    { "path": "/internal/cron/author-history", "schedule": "* * * * *" },
    { "path": "/internal/cron/read-state-recovery", "schedule": "* * * * *" }
  ]
}
