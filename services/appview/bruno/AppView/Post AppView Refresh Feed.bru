meta {
  name: Post AppView Refresh Feed
  type: http
  seq: 28
}

post {
  url: {{baseUrl}}/xrpc/app.thesocialwire.appview.refreshFeed
  body: json
  auth: none
}

headers {
  Accept: application/x-ndjson
  Authorization: Bearer {{oauthAccessToken}}
  DPoP: {{dpopProof}}
}

body:json {
  {
    "kind": "subscribed"
  }
}

docs {
  Explicit refresh of one viewer feed (`subscribed`, `following`, `folder`, `publication`, or `list`;
  `id` is required for the last three). Proxied to AppView without response buffering.

  Returns `application/x-ndjson`: `started` `{ total }`, one `publication`
  `{ publicationId, status, indexed, completed, total }` per source as it finishes
  (`status` is `updated`, `checked`, or `unavailable`), then `done` `{ total, indexed, unavailable }`.
}
