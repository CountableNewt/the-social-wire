meta {
  name: XRPC app.thesocialwire.articleDraft.put
  type: http
  seq: 122
}

post {
  url: {{baseUrl}}/xrpc/app.thesocialwire.articleDraft.put
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{oauthAccessToken}}
  DPoP: {{dpopProof}}
  Content-Type: application/json
}

body:json {
{
  "expectedRevision": 0,
  "mutationId": "{{articleDraftMutationId}}",
  "draft": {
    "id": "{{articleDraftId}}",
    "title": "Private Article",
    "markdown": "This draft remains private until an explicit publishing action.",
    "excerpt": "",
    "path": "",
    "tags": [],
    "publicationUri": "{{publicationAtUri}}",
    "createdAt": "2026-11-06T00:00:00Z",
    "updatedAt": "2026-11-06T00:00:00Z",
    "assets": []
  },
  "attachments": []
}
}

docs {
  Owner-only encrypted server-side article drafts. Never writes draft content or images to the PDS.
  Responses are private, no-store and nosniff; authenticated DID determines ownership.
  Use canonical lowercase UUID articleDraftId and articleDraftMutationId values.
  CAS expectedRevision is 0 for creation; reuse a mutation ID only with its identical request.
  Tombstones never resurrect. Upload private photos through socialDraft reserve/upload first,
  then bind them atomically with put attachments [{localAssetId, assetId}].
  list uses exclusive UUID cursor pagination (limit 1..20) and includes tombstones.
}
