{
  "lexicon": 1,
  "id": "at.skej.team.brandGrant",
  "defs": {
    "main": {
      "type": "record",
      "description": "A Skej brand capability grant for a member or group.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": [
          "teamUri",
          "brandDid",
          "granteeType",
          "grantee",
          "capabilities",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "teamUri": {
            "type": "string",
            "format": "at-uri"
          },
          "brandDid": {
            "type": "string",
            "format": "did"
          },
          "granteeType": {
            "type": "string",
            "enum": [
              "member",
              "group"
            ],
            "maxLength": 8192
          },
          "grantee": {
            "type": "string",
            "description": "Member DID for member grants, group AT-URI for group grants.",
            "maxLength": 8192
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "create",
                "approve",
                "manage",
                "viewAnalytics"
              ],
              "maxLength": 8192
            },
            "minLength": 1,
            "maxLength": 4
          },
          "status": {
            "type": "string",
            "knownValues": ["active", "revoked"],
            "description": "Missing on legacy records means active."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
