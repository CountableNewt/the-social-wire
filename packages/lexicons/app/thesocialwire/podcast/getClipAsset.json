{
  "lexicon": 1,
  "id": "app.thesocialwire.podcast.getClipAsset",
  "defs": {
    "main": {
      "type": "query",
      "description": "Read Podcast Assets",
      "parameters": {
        "type": "params",
        "properties": {
          "clipId": {
            "type": "string",
            "maxLength": 4096
          },
          "format": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "output": {
        "encoding": "*/*"
      },
      "errors": [
        {
          "name": "NotFound"
        },
        {
          "name": "RangeNotSatisfiable"
        }
      ]
    }
  }
}
