              "maxGraphemes": 512
            },
            "description": {
              "type": "string",
              "maxLength": 8192,
              "maxGraphemes": 2048
            },
            "image": {
              "type": "string",
              "format": "uri",
              "maxLength": 8192,
              "maxGraphemes": 2048
            },
            "siteName": {
