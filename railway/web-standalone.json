{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/apps/web/Dockerfile",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/**",
      "/scripts/ci/**",
      "/services/**",
      "/database/**",
      "/package.json",
      "/bun.lock",
      "/turbo.json",
      "/.dockerignore",
      "/railway/web-standalone.json"
    ]
  },
  "deploy": {
    "startCommand": null,
    "preDeployCommand": null,
    "numReplicas": 1,
    "region": "sfo",
    "multiRegionConfig": {
      "sfo": {
        "numReplicas": 1
      }
    },
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}
