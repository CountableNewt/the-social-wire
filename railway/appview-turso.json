{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/services/appview/Dockerfile.standalone",
    "watchPatterns": [
      "/services/appview/**",
      "/packages/vendor/**",
      "/apps/web/package.json",
      "/packages/read-state/package.json",
      "/packages/lexicons/package.json",
      "/packages/spec/package.json",
      "/package.json",
      "/bun.lock",
      "/.dockerignore",
      "/railway/appview-standalone.json",
      "/railway/appview-turso.json"
    ]
  },
  "deploy": {
    "startCommand": null,
    "preDeployCommand": "/usr/local/bin/AppView --initialize-only",
    "numReplicas": 1,
    "region": "sfo",
    "multiRegionConfig": {
      "sfo": {
        "numReplicas": 1
      }
    },
    "sleepApplication": false,
    "overlapSeconds": 0,
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 600,
    "restartPolicyType": "ALWAYS"
  }
}
