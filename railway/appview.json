{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/services/appview/Dockerfile",
    "watchPatterns": [
      "/services/appview/**",
      "/database/migrations/**",
      "/railway/appview.json",
      "/tools/schema-ready/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/readyz",
    "healthcheckTimeout": 600,
    "restartPolicyType": "ALWAYS"
  }
}
